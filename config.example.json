{
  "udp_idle_timeout": "2m",
  "routes": [
    {
      "name": "web-to-b",
      "proto": "tcp",
      "listen": "0.0.0.0:80",
      "target": "172.31.255.2:80"
    },
    {
      "name": "http-web-to-b",
      "proto": "http",
      "listen": "127.0.0.1:8080",
      "target": "http://172.31.255.2:80",
      "host_header": "172.31.255.2"
    },
    {
      "name": "https-to-b",
      "proto": "tcp",
      "listen": "0.0.0.0:443",
      "target": "172.31.255.2:443"
    },
    {
      "name": "wireguard-like-udp-example",
      "proto": "udp",
      "listen": "0.0.0.0:51820",
      "target": "172.31.255.2:51820"
    }
  ]
}
